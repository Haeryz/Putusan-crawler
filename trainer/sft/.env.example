# Copy this file to trainer/sft/.env before running download_model.sh.
# Create a read token at https://huggingface.co/settings/tokens.
HF_TOKEN=hf_your_huggingface_read_token

# Required by the preflight and by all three tracked training runs.
WANDB_API_KEY=your_weights_and_biases_api_key

# Keep the model cache on the persistent RunPod volume.
HF_HOME=/workspace/.cache/huggingface
